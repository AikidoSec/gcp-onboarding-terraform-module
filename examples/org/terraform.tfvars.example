# Copy this file to terraform.tfvars and fill in your values

# GCP organization ID to connect to Aikido
# Find with: gcloud organizations list
organization_id = "1234567890"

# GCP project ID that will host the Workload Identity Pool
host_project_id = "your-host-project-id"

# GCP project number for the host project
# Find with: gcloud projects describe your-host-project-id --format='value(projectNumber)'
host_project_number = "123456789"

# Enable artifact registry scanning (disabled by default)
enable_artifact_registry_reader = false
